	<!-- Seed the remaining identity data needed to exercise the first login flow: three seed
	     users all sharing the password "abc123" (admin/platform admin, Satoshi/brand admin,
	     Omri/collector), a default "Pokemon" brand, and the sample role assignments tying users
	     to the roles seeded above (looked up by role_name, not the fixed role_id values, so this
	     file stays readable without cross-referencing the UUIDs above). This is intentionally
	     executed once, guarded by a precondition so local reboots or repeated app starts do not
	     duplicate the seed data. -->
	<changeSet id="005-seed-identity-data" author="copilot">
		<preConditions onFail="MARK_RAN">
			<sqlCheck expectedResult="0">SELECT COUNT(*) FROM platform_user WHERE email = 'admin@example.com';</sqlCheck>
		</preConditions>
		<sqlFile path="insert.sql" relativeToChangelogFile="true" splitStatements="true" stripComments="true"/>
	</changeSet>

</databaseChangeLog>
