	<!-- Example role catalog, per design doc 2.2.2 "Identity Tables and Role Model":
	     COLLECTOR, BRAND_VIEWER, BRAND_EDITOR, BRAND_ADMIN, PLATFORM_ADMIN, SUPPORT_AGENT,
	     COMPLIANCE_OFFICER, SERVICE_ACCOUNT. role_type groups roles by the scope_type they are
	     assigned under in role_assignment (PLATFORM, BRAND, COLLECTOR, SUPPORT, COMPLIANCE,
	     SERVICE). is_privileged flags roles that should require step-up authentication per
	     section 2.2.3/2.2.4. Written as native Liquibase <insert> changes (fixed role_id/
	     permission_id UUIDs below) rather than raw SQL so role_permission can reference these
	     rows by literal foreign key without a lookup subquery. -->
	<changeSet id="005-seed-roles" author="copilot">
		<preConditions onFail="MARK_RAN">
			<sqlCheck expectedResult="0">SELECT COUNT(*) FROM role WHERE role_name = 'COLLECTOR';</sqlCheck>
		</preConditions>
		<insert tableName="role">
			<column name="role_id" value="140be251-444d-45b0-b9be-aca84b6db7d8"/>
			<column name="role_name" value="COLLECTOR"/>
			<column name="description" value="Collector account holder; access limited to own account, vault, and ownership records."/>
			<column name="role_type" value="COLLECTOR"/>
			<column name="is_privileged" valueBoolean="false"/>
		</insert>
		<insert tableName="role">
			<column name="role_id" value="d68b99a4-23d6-4d9e-b1f2-5ca85f0cb274"/>
			<column name="role_name" value="BRAND_VIEWER"/>
			<column name="description" value="Read-only access to a single brand's collections, templates, and reports."/>
			<column name="role_type" value="BRAND"/>
			<column name="is_privileged" valueBoolean="false"/>
		</insert>
		<insert tableName="role">
			<column name="role_id" value="03c94108-a4a7-40a6-a457-5c647e0c67ab"/>
			<column name="role_name" value="BRAND_EDITOR"/>
			<column name="description" value="Can create and edit collections/templates within a single assigned brand."/>
			<column name="role_type" value="BRAND"/>
			<column name="is_privileged" valueBoolean="false"/>
		</insert>
		<insert tableName="role">
			<column name="role_id" value="59839925-d3af-4cba-aec8-8aed5691f7fc"/>
			<column name="role_name" value="BRAND_ADMIN"/>
			<column name="description" value="Full administrative access within a single assigned brand, including template approval."/>
			<column name="role_type" value="BRAND"/>
			<column name="is_privileged" valueBoolean="true"/>
		</insert>
		<insert tableName="role">
			<column name="role_id" value="d4dec3b5-f0b2-4a1d-87ef-298491732bdf"/>
			<column name="role_name" value="PLATFORM_ADMIN"/>
			<column name="description" value="Cross-brand platform configuration and identity/role administration."/>
			<column name="role_type" value="PLATFORM"/>
			<column name="is_privileged" valueBoolean="true"/>
		</insert>
		<insert tableName="role">
			<column name="role_id" value="ae2c3ef5-28bb-4600-a6e5-83c566ec59cf"/>
			<column name="role_name" value="SUPPORT_AGENT"/>
			<column name="description" value="Limited, auditable access to user accounts for support purposes."/>
			<column name="role_type" value="SUPPORT"/>
			<column name="is_privileged" valueBoolean="false"/>
		</insert>
		<insert tableName="role">
			<column name="role_id" value="b434dc32-8424-41a7-86a1-0e4d5c895157"/>
			<column name="role_name" value="COMPLIANCE_OFFICER"/>
			<column name="description" value="Access to audit trails and compliance-sensitive records."/>
			<column name="role_type" value="COMPLIANCE"/>
			<column name="is_privileged" valueBoolean="true"/>
		</insert>
		<insert tableName="role">
			<column name="role_id" value="65c62ae8-14f5-4f42-9325-5f0409701a64"/>
			<column name="role_name" value="SERVICE_ACCOUNT"/>
			<column name="description" value="Non-human actor calling internal APIs under an explicit service scope."/>
			<column name="role_type" value="SERVICE"/>
			<column name="is_privileged" valueBoolean="true"/>
		</insert>
	</changeSet>

	<!-- Example fine-grained permissions. permission_key follows RESOURCE:ACTION convention;
	     resource_type/action columns duplicate that same information in a queryable form. The
	     brand-scoped resources (COLLECTION/TEMPLATE) deliberately omit any brand qualifier -
	     which brand a grant applies to is carried entirely by role_assignment.scope_type='BRAND'/
	     scope_id, never by the permission key itself. -->
	<changeSet id="005-seed-permissions" author="copilot">
		<preConditions onFail="MARK_RAN">
			<sqlCheck expectedResult="0">SELECT COUNT(*) FROM permission WHERE permission_key = 'COLLECTOR_PROFILE:READ';</sqlCheck>
		</preConditions>
		<insert tableName="permission">
			<column name="permission_id" value="9d3c7ef3-010e-4992-960d-5fa8a7f87a29"/>
			<column name="permission_key" value="COLLECTOR_PROFILE:READ"/>
